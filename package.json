{
  "name": "@rcrsr/claude-code-runner",
  "version": "0.16.0",
  "description": "Execute Claude CLI with PTY handling, real-time tool visualization, and iterative execution support",
  "keywords": [
    "automation",
    "claude",
    "cli",
    "runner"
  ],
  "homepage": "https://github.com/rcrsr/claude-code-runner#readme",
  "bugs": {
    "url": "https://github.com/rcrsr/claude-code-runner/issues"
  },
  "license": "MIT",
  "author": "Andre Bremer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/claude-code-runner.git"
  },
  "bin": {
    "claude-code-runner": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run check:types && npm run check:lint && npm run check:format && npm run check:deps && npm run test",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint --deny-warnings",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@rcrsr/rill": "~0.19.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
