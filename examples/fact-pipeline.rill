---
description: Generate facts about a topic, then summarize and translate
args: topic: string, language: string = "Spanish"
---

# Step 1: Generate facts about the topic
ccr::state("Generating facts about {$topic}")
"""
List 5 interesting facts about {$topic}.
Format as a numbered list.
"""
  -> ccr::prompt => $facts

log("Generated facts about {$topic}")

# Step 2: Summarize the facts into a single paragraph
ccr::state("Summarizing facts")
"""
Summarize these facts into a single concise paragraph:

{$facts}
"""
  -> ccr::prompt => $summary

log("Created summary")

# Step 3: Translate the summary
ccr::state("Translating to {$language}")
"""
Translate this text to {$language}:

{$summary}
"""
  -> ccr::prompt => $translated

log("Translated to {$language}")

# Output final result
ccr::state("Done")
log("=== Original Summary ===")
log($summary)
log("=== {$language} Translation ===")
log($translated)
